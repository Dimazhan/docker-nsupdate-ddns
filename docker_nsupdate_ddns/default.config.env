DOCKER_SOCKET=/var/run/docker.sock
HOSTNAME_LABEL=hostname
IGNORE_LABEL=ignore
USE_LABEL=use
IGNORE_IPV6_LABEL=ignore_ipv6
IGNORE_IPV4_LABEL=ignore_ipv4
USE_IPV6_LABEL=use_ipv6
USE_IPV4_LABEL=use_ipv4
DNS_RECORD_TTL=60
REFRESH_INTERVAL=60
ONE_SHOT=False
DEFAULT_NETWORK=None
PORT=53
CHECK_RECORDS=False
TSIG_ALGORITHM=hmac-sha256
DEFAULT_IGNORE=False
IGNORE_IPV6=False
IGNORE_IPV4=False
